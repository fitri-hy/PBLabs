# Database
# Example: 127.0.0.1
PB_DB_HOST=127.0.0.1

# Example: 5432
PB_DB_PORT=5432

# Example: pb
PB_DB_NAME=pb

# Example: postgres
PB_DB_USER=postgres

# Example: password123
PB_DB_PASS=postgres

# Full Database URL (replaces the settings above)
# Example: postgres://postgres:password123@127.0.0.1:5432/pb
# PB_DB_URL=postgres://postgres:password123@127.0.0.1:5432/pb

# Database SSL
# Example: 0 (disabled), 1 (enabled)
# PB_DB_SSL=0

# Example: 0 (disabled), 1 (validate certificates)
# PB_DB_SSL_STRICT=0

# Web Server
# Example: 8090
# PB_WEB_PORT=8090

# Server List
# Example: LAN IP or public IP
# PB_ADVERTISE_HOST=192.168.1.10

# P2P / TURN
# Example: turn:turn.example.com:3478
# TURN_URLS=turn:turn.example.com:3478

# Example: player
# TURN_USERNAME=username

# Example: secret123
# TURN_CREDENTIAL=password

# Logs
# Example: 0 (full logs), 1 (quiet mode)
# PB_LOG_QUIET=1

# Example: .* (hide all filtered logs)
# PB_LOG_HIDE=.*